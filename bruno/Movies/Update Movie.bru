meta {
  name: Update Movie
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/v1/movies/:id
  body: json
}

params:path {
  id: 1
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "title": "Moana",
    "year": 2016,
    "runtime": "107 mins",
    "genres": ["animation", "adventure"]
  }
}
